# ==============================================================================
# KruschLaw Environment Configuration
# ==============================================================================
# Copy this file to .env before starting services:
#   cp .env.example .env
# ==============================================================================

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_DB=kruschlaw_db
POSTGRES_USER=kruschlaw
POSTGRES_PASSWORD=change_this_secure_password
DATABASE_PORT=5435

# Full Database URL for backend service
# Inside docker-compose network, the host is 'db':
DATABASE_URL=postgresql://kruschlaw:change_this_secure_password@db:5432/kruschlaw_db

# Local Ollama Inference & Embedding Hosts
# If running Ollama on your host machine from inside Docker containers:
#   Linux: http://172.17.0.1:11434 or host IP
#   macOS/Windows: http://host.docker.internal:11434
# If running Ollama on a remote LAN node:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_HOST=http://localhost:11434

# Models
# Embedding model (1024-dim recommended: bge-large, nomic-embed-text)
OLLAMA_EMBED_MODEL=bge-large
# Reasoning / Chat model (qwen2.5-coder:14b, llama3.1:8b, mistral, etc.)
OLLAMA_LLM_MODEL=qwen2.5-coder:14b

# Service Ports (Host Bindings)
BACKEND_PORT=8085
FRONTEND_PORT=8505

# Internal Networking (Frontend -> Backend URL)
BACKEND_URL=http://backend:8000
